#!/usr/bin/make -f

%:
	dh $@

override_dh_strip:
	# Skip stripping debug symbols - PyInstaller binaries don't handle it well
	dh_strip --exclude=_internal

override_dh_shlibdeps:
	# Skip shared library dependencies - PyInstaller bundles everything
	dh_shlibdeps --exclude=_internal

override_dh_dwz:
	# Skip DWARF optimization - PyInstaller .so files lack .debug_info
	# and the Go binary has compressed debug sections dwz can't handle
	dh_dwz --exclude=_internal --exclude=ns


override_dh_installsystemd:
	dh_installsystemd --name=ns ns.service
	dh_installsystemd --name=ns-admin ns-admin.service